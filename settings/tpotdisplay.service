[Unit]
Description=T-Pot Mobile Qt Quick display
Wants=tpotweston.service
After=tpotweston.service

[Service]
Type=simple
User=tpotui
Group=tpotui
SupplementaryGroups=render i2c
WorkingDirectory=/opt/tpotmobile
Environment=XDG_RUNTIME_DIR=/run/tpotmobile WAYLAND_DISPLAY=wayland-0 QT_QPA_PLATFORM=wayland QT_QUICK_CONTROLS_STYLE=Basic
ExecStart=/opt/tpotmobile/tools/start-display.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=multi-user.target
